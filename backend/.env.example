# Application & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8005
BACKEND_URL=http://localhost:8005
FRONTEND_URL=http://localhost:5174
DEFAULT_TIMEZONE=UTC
SECRET_KEY=incubrix_jwt_super_secret_production_ready_key_12345
APP_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://incubrix:incubrix_dev@localhost:5434/incubrix_social
SYNC_DATABASE_URL=postgresql://incubrix:incubrix_dev@localhost:5434/incubrix_social

# Redis (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incubrix-assets
MINIO_SECURE=false

# Google Vertex AI (Gemini models served via Vertex AI; ADC-based auth)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Primary / fallback Gemini model names on Vertex AI
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_CAROUSEL_MODEL=gemini-3.5-flash-lite
GEMINI_CAROUSEL_FALLBACK_MODEL=gemini-3.1-flash-lite

# Meta (Facebook Pages & Instagram Professional)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8005/api/v1/oauth/meta/callback
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=Incubrix
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=

# YouTube (Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:8005/api/v1/oauth/youtube/callback
YOUTUBE_ACCESS_TOKEN=

# X (Twitter API v2)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8005/api/v1/oauth/x/callback
